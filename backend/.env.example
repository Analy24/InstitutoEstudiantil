# Configuración del Servidor
PORT=5000
NODE_ENV=production

# Seguridad JWT (Generar con: openssl rand -hex 32)
JWT_SECRET=<REEMPLAZAR_CON_CLAVE_SECRETA_ALEATORIA_64_CARACTERES>
JWT_EXPIRES_IN=8h

# Conexión Base de Datos (SQLite)
DB_PATH=./database.sqlite

# Configuración de URLs (Dominio o IP de Producción)
FRONTEND_URL=https://tu-dominio.com

# Configuración de Correo Electrónico SMTP
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=notificaciones@tu-dominio.com
SMTP_PASS=<CONTRASEÑA_DE_APLICACION_SMTP>
