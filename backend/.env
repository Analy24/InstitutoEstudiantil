# Configuración del Servidor
PORT=5000
NODE_ENV=production

# Seguridad JWT
JWT_SECRET=instituto_estudiantil_secret_token_2026_super_seguro_key
JWT_EXPIRES_IN=8h

# Conexión Base de Datos MySQL (XAMPP / MySQL Workbench / Docker / Cloud)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=articulapp_db

# Configuración de URLs
FRONTEND_URL=http://localhost:5000

# Configuración de Correo Electrónico SMTP (Para envíos reales a Gmail / correos corporativos)
# Si deseas que los correos lleguen REALMENTE a la bandeja de entrada de las empresas (Gmail/Hotmail/etc.):
# 1. Coloca tu cuenta de correo de envío en SMTP_USER (ej: tu_correo@gmail.com)
# 2. Si usas Gmail, genera una Contraseña de Aplicación de 16 letras en https://myaccount.google.com/apppasswords y colócala en SMTP_PASS.
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

